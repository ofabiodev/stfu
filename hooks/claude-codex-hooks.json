{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stfu-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading STFU mode"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stfu-prompt.js\"",
            "timeout": 5,
            "statusMessage": "Applying STFU mode"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stfu-subagent.js\"",
            "timeout": 5,
            "statusMessage": "Loading STFU mode for subagent"
          }
        ]
      }
    ]
  }
}
